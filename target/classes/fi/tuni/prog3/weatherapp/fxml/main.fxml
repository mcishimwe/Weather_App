<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane id="mainBorderPane" prefHeight="914.0" prefWidth="1129.0" styleClass="main-view" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fi.tuni.prog3.weatherapp.controller.MainController">
    <stylesheets>
        <URL value="@/fi/tuni/prog3/weatherapp/styles/main.css" />
        
    </stylesheets>
    
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="25.0" prefWidth="1050.0" styleClass="search-bar">
            <Button fx:id="favoritesButton" onAction="#handlefavoritesButton" prefHeight="25.0" prefWidth="206.0" styleClass="top-button" text="Add to Favorites" />
            <Button fx:id="historyButton" onAction="#handleHistoryButton" styleClass="top-button" text="Clear history" />
            
            <ComboBox fx:id="searchField" editable="true" onAction="#handleSearchAction" promptText="Search..." style="-fx-scale-x: 1;" styleClass="search-field" />
            <Label fx:id="warningsLabel" />

            
            

        </HBox>
    </top>
    
    <center>
        <fx:include fx:id="currentWeather" source="currentWeather.fxml" />
    </center>
    
    <bottom>
        <fx:include fx:id="hourlyForecast" source="hourlyForecast.fxml" translateX="-10.0" translateY="-100.0" />
    </bottom>
    
    <right>
        <VBox prefHeight="533.0" prefWidth="673.0">
            <Label text="Upcoming Week:">
            <font>
               <Font name="System Bold" size="15.0" />
            </font></Label>
            <fx:include fx:id="dailyWeather" source="dailyForecast.fxml" />
            <Label prefHeight="21.0" prefWidth="83.0" style="-fx-translate-y: -50;" text="Favorites:">
            <font>
               <Font name="System Bold" size="15.0" />
            </font></Label>
            <Button fx:id="city1Button" prefHeight="100.0" prefWidth="315.0" style="-fx-translate-y: -50;" visible="false">
            
                <graphic>
                    <HBox spacing="5">
                        
                        <Label fx:id="city1Label" />
                        <ImageView fx:id="city1IconImageView" fitHeight="20" fitWidth="20" />
                    </HBox>
                </graphic>
            </Button>
            <Button fx:id="city2Button" prefHeight="100.0" prefWidth="314.0" style="-fx-translate-y: -50;" visible="false">
                <graphic>
                    <HBox spacing="5">
                        <Label fx:id="city2Label" />
                        <ImageView fx:id="city2IconImageView" fitHeight="20" fitWidth="20" />
                    </HBox>
                </graphic>
            </Button>
            <Button fx:id="city3Button" prefHeight="100.0" prefWidth="311.0" style="-fx-translate-y: -50;" visible="false">
                <graphic>
                    <HBox spacing="5">
                        
                        <Label fx:id="city3Label" />
                        <ImageView fx:id="city3IconImageView" fitHeight="20" fitWidth="20" />
                    </HBox>
                </graphic>
            </Button>
            
        </VBox>
        
        
        
    </right>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
</BorderPane>
